{
  "name": "avenlo-core",
  "version": "1.0.0",
  "description": "Hybrid Microservice Infrastructure for Avenlo Studio",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:architect\" \"npm run dev:pulse\" \"npm run dev:ledger\"",
    "dev:gateway": "npm run dev -w @avenlo/gateway",
    "dev:architect": "npm run dev -w @avenlo/architect",
    "dev:pulse": "npm run dev -w @avenlo/pulse",
    "dev:ledger": "npm run dev -w @avenlo/ledger",
    "build": "npm run build -ws",
    "start": "npm run start -ws --if-present",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint . --ext .ts,.js",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/uuid": "^9.0.8",
    "uuid": "^9.0.1"
  }
}
