{
  "name": "avenlo-core",
  "version": "1.0.0",
  "description": "Hybrid Microservice Infrastructure for Avenlo Studio",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:architect\" \"npm run dev:pulse\" \"npm run dev:ledger\"",
    "dev:gateway": "npm run dev -w @avenlo/gateway",
    "dev:architect": "npm run dev -w @avenlo/architect",
    "dev:pulse": "npm run dev -w @avenlo/pulse",
    "dev:ledger": "npm run dev -w @avenlo/ledger",
    "build": "npm run build -ws",
    "start": "npm run start -ws --if-present",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint .",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "redis-memory-server": "^0.16.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.12.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/uuid": "^9.0.8",
    "uuid": "^9.0.1"
  },
  "packageManager": "pnpm@8.15.0+sha512.ea45517d5285d123eac02c3793505fa1fd6da90a2fc60d1e8d9e0c1e9292886ecfaff513f062b9d1cc8021bb8615033b1ac5bea3b2ee3fc165a6d7034bbe6b03"
}
