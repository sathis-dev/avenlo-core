# ====================================
# AVENLO CORE - ENVIRONMENT VARIABLES
# ====================================

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=your_discord_guild_id

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/avenlo?retryWrites=true&w=majority
MONGODB_DB_NAME=avenlo_core

# Redis Configuration
REDIS_URL=redis://default:password@redis.railway.internal:6379

# AI Configuration (OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_PROVIDER=openai  # or 'anthropic'
AI_MODEL=gpt-4o  # or 'claude-3-5-sonnet-20241022'

# GitHub Integration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_ORG=your_github_org

# Encryption
ENCRYPTION_KEY=your_32_byte_hex_encryption_key
ENCRYPTION_IV=your_16_byte_hex_iv

# Railway Configuration
RAILWAY_ENVIRONMENT=production
PORT=3000

# Channel IDs
CHANNEL_ACTIVE_PROJECTS=your_active_projects_channel_id
CHANNEL_LOGS=your_logs_channel_id
CHANNEL_VAULT=your_vault_channel_id

# Role IDs
ROLE_STUDIO_LEAD=your_studio_lead_role_id
ROLE_ACTIVE_DEV=your_active_dev_role_id
ROLE_CONTRIBUTOR=your_contributor_role_id
