# ====================================
# AVENLO CORE - ENVIRONMENT VARIABLES
# Copy to .env and fill in values
# ====================================

# ====================================
# DISCORD CONFIGURATION
# ====================================
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_GUILD_ID=your_discord_guild_id

# ====================================
# DATABASE
# ====================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/avenlo?retryWrites=true&w=majority
MONGODB_DB_NAME=avenlo_core

# ====================================
# REDIS
# ====================================
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ====================================
# AI CONFIGURATION
# ====================================
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# ====================================
# ARCHITECT - MULTI-AGENT MODE
# ====================================
# Enable Trinity Agent Model (NEXUS → SENTINEL → ORACLE)
ARCHITECT_MULTI_AGENT=true
MAX_DEBATE_ROUNDS=3
AUTO_APPROVE_THRESHOLD=7

# ====================================
# GUARDIAN - AI MODERATION
# ====================================
# Enable 3-layer cognitive moderation pipeline
GUARDIAN_ENABLED=true

# ====================================
# GITHUB INTEGRATION
# ====================================
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_ORG=your_github_org

# ====================================
# SECURITY
# ====================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_encryption_key
ENCRYPTION_IV=your_16_byte_hex_iv
SESSION_SECRET=your_session_secret

# ====================================
# RAILWAY CONFIGURATION
# ====================================
RAILWAY_ENVIRONMENT=production
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ====================================
# CHANNEL IDS
# ====================================
CHANNEL_ACTIVE_PROJECTS=your_active_projects_channel_id
CHANNEL_LOGS=your_logs_channel_id
CHANNEL_VAULT=your_vault_channel_id
CHANNEL_DEVOPS=your_devops_channel_id
CHANNEL_BUILDS=your_builds_channel_id

# ====================================
# ROLE IDS
# ====================================
ROLE_STUDIO_LEAD=your_studio_lead_role_id
ROLE_ACTIVE_DEV=your_active_dev_role_id
ROLE_CONTRIBUTOR=your_contributor_role_id

# ====================================
# LEDGER - CREDIT REWARDS
# ====================================
CREDITS_TICKET_RESOLVED=10
CREDITS_COMMIT_PUSHED=2
CREDITS_PR_MERGED=15

# ====================================
# DASHBOARD - OAUTH
# ====================================
DISCORD_CALLBACK_URL=https://your-dashboard.railway.app/auth/callback
VITE_API_URL=https://your-gateway.railway.app
